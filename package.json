{
  "name": "effectivity-web",
  "version": "0.1.0",
  "private": true,
  "description": "Thin web surface for the effectivity resolver. The Python package is the only decision logic.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "python3 tools/dev_api.py",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:rules": "node scripts/gen-rules.mjs",
    "check:rules": "node scripts/gen-rules.mjs --check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "verify": "npm run secret-scan && npm run check:rules && npm run check:tokens && npm run lint && npm run format:check && npm test && npm run build && npm run typecheck"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
